@page
@model Showheel.Pages.ArcheonModel
@{
    ViewData["Title"] = "Archeon — Skies Beyond the Star";
    ViewData["BodyClass"] = "archeon-page";
}

<section class="kd-detail-hero">
    <div class="kd-detail-hero-bg"
         style="background-image: url('/images/anna1.png');"
         aria-hidden="true"></div>
    <div class="kd-detail-hero-shade" aria-hidden="true"></div>
    <div class="kd-detail-hero-inner">
        <p class="kd-eyebrow">01 · Flagship</p>
        <h1 class="kd-detail-title">Skies Beyond the Star</h1>
        <p class="kd-detail-sub">Archeon — a long-form cinematic sci-fi universe blending narrative, music, and 3D worldbuilding.</p>
    </div>
    <a class="kd-scroll-cue" href="#archeon-body" aria-label="Scroll to content"><span class="kd-scroll-arrow"></span></a>
</section>

<link rel="stylesheet" href="~/css/story-reader.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/archeon-music.css" asp-append-version="true" />
<aside class="archeon-music" data-archeon-music aria-label="Archeon 背景音乐">
    <div class="archeon-music-row">
        <span class="archeon-music-title" data-music-title>Archeon vibe 1 · 1/9</span>
        <div class="archeon-music-controls" role="group" aria-label="音乐播放控制">
            <button type="button" data-music-previous aria-label="上一首" title="上一首">⏮</button>
            <button type="button" data-music-toggle aria-label="播放背景音乐">播放</button>
            <button type="button" data-music-next aria-label="下一首" title="下一首">⏭</button>
        </div>
    </div>
    <div class="archeon-music-status" data-music-status role="status" aria-live="polite">加载中…</div>
    <audio preload="metadata" hidden></audio>
    <script type="application/json" data-music-tracks>
        [
            {"title":"Archeon vibe 1","src":"/images/archeonvibe1.mp3"},
            {"title":"Archeon vibe 2","src":"/images/archeonvibe2.mp3"},
            {"title":"Archeon vibe 3","src":"/images/archeonvibe3.mp3"},
            {"title":"Archeon vibe 4","src":"/images/archeonvibe4.mp3"},
            {"title":"Archeon vibe 5","src":"/images/archeonvibe5.mp3"},
            {"title":"Archeon vibe 6","src":"/images/archeonvibe6.mp3"},
            {"title":"Archeon vibe 7","src":"/images/archeonvibe7.mp3"},
            {"title":"Archeon vibe 8","src":"/images/archeonvibe8.mp3"},
            {"title":"Archeon vibe 9","src":"/images/archeonvibe9.mp3"}
        ]
    </script>
</aside>
<section id="archeon-body" class="kd-detail-body kd-detail-body--archeon">
    <div class="kd-detail-inner">
        <div class="archeon-map-frame">
            <iframe src="/archeon-atlas/index.html" title="Archeon 世界地图 · Interactive World Atlas" loading="lazy"></iframe>
        </div>
        <div id="archeon-story" class="archeon-reading">
            <section class="story-reader" data-story-reader data-default-lang="zh" aria-label="Story reader">
                <header class="story-toolbar">
                    <h2 data-story-heading>小说与世界设定</h2>
                    <div class="story-language" role="group" aria-label="阅读语言 / Reading language">
                        <button type="button" data-story-lang="zh" aria-pressed="true">中文</button>
                        <button type="button" data-story-lang="en" aria-pressed="false">English</button>
                    </div>
                </header>
                <div class="story-status"><p data-story-status role="status" aria-live="polite"></p><button class="story-retry" type="button" data-story-retry hidden>重新加载</button></div>
                <div class="story-scroll" data-story-scroll tabindex="0" role="region" aria-label="小说正文" aria-busy="true"></div>
                <noscript><p>请启用 JavaScript 阅读，或打开 <a href="/story.md">中文全文</a> / <a href="/story-engl.md">English manuscript</a>。</p></noscript>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/vendor/marked/marked.umd.js" asp-append-version="true" defer></script>
    <script src="~/vendor/dompurify/purify.min.js" asp-append-version="true" defer></script>
    <script src="~/js/story-reader.js" asp-append-version="true" defer></script>
    <script src="~/js/archeon-music.js" asp-append-version="true" defer></script>
}
