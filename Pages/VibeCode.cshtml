<section id="vibecode-body" class="kd-detail-body">
    <div class="kd-detail-inner">
        <nav class="sec-jump" aria-label="On this page" data-reveal>
            <a class="kd-pill" href="#process">How I work</a>
            <a class="kd-pill" href="#epsilon">Epsilon boss AI</a>
