@page
@model Showheel.Pages.MinecraftModel
@{
    ViewData["Title"] = "Personal Interest — Yingrong Lin";
}

<section class="kd-detail-hero">
    <div class="kd-detail-hero-bg background-image"
         data-motion-depth="1.05"
         data-motion-scale="1.1"
         style="background-image: url('/images/mc.png');"
         aria-hidden="true"></div>
    <div class="kd-detail-hero-shade" aria-hidden="true"></div>
    <div class="kd-detail-hero-inner">
        <p class="kd-eyebrow">06 · Personal Interest</p>
        <h1 class="kd-detail-title">Personal Interest</h1>
        <p class="kd-detail-sub">Mods I build for the games I love.</p>
    </div>
    <a class="kd-scroll-cue" href="#mc-body" aria-label="Scroll to content"><span class="kd-scroll-arrow"></span></a>
</section>

<section id="mc-body" class="kd-detail-body">
    <div class="kd-detail-inner">
        <nav class="sec-jump" aria-label="On this page" data-reveal>
            <a class="kd-pill" href="#minecraft">Minecraft · Frieren</a>
            <a class="kd-pill" href="#rdr2">Red Dead Redemption 2 · Sarah Miller</a>
        </nav>

        @* ── Minecraft ───────────────────────────────────── *@
        <section id="minecraft" class="sec-block sec-mod" aria-labelledby="minecraft-title">
            <header class="sec-head" data-reveal>
                <p class="kd-eyebrow">Minecraft mod</p>
                <h2 id="minecraft-title" class="sec-title">Minecraft — Frieren: Beyond Journey&rsquo;s End</h2>
                <p class="sec-lede">A solo-built Minecraft mod blending narrative design with math-driven combat systems.</p>
            </header>

            <div class="kd-feature-grid">
                <div class="kd-feature-main" data-reveal>
                    <div class="kd-media-frame kd-video-frame">
                        <iframe
                            src="https://www.youtube.com/embed/t7VkB6CaaTY?autoplay=1&mute=1&loop=1&controls=1&rel=0&playlist=t7VkB6CaaTY"
                            title="Frieren mod showcase"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                            referrerpolicy="strict-origin-when-cross-origin"
                            playsinline></iframe>
                    </div>
                    <p class="kd-caption">Mod gameplay reel — combat systems &amp; trigonometric easing.</p>
                </div>
                <aside class="kd-feature-side">
                    <div class="kd-side-card kd-side-card-text" data-reveal data-reveal-delay="1">
                        <p class="kd-eyebrow">Independent Build</p>
                        <h3>Math-driven combat</h3>
                        <p>Custom spell trajectories, AI motion curves, and encounter pacing built on top of trigonometric easing functions and a game-design-first mindset.</p>
                        <ul class="kd-list">
                            <li>Custom combat motion using trigonometric easing.</li>
                            <li>Hand-crafted quest flow and worldbuilding beats.</li>
                            <li>Cinematic camera paths for storytelling moments.</li>
                        </ul>
                        <div class="kd-link-row">
                            <a class="kd-pill" href="https://www.curseforge.com/minecraft/mc-mods/frieren-beyond-journeys-end" target="_blank" rel="noopener noreferrer">CurseForge</a>
                            <a class="kd-pill" href="https://xfreedman01.itch.io/mcreator-sword-slash-demo" target="_blank" rel="noopener noreferrer">itch.io tutorial</a>
                        </div>
                    </div>
                    <div class="kd-side-card" data-reveal data-reveal-delay="2">
                        <a class="kd-side-media" href="https://xfreedman01.itch.io/mcreator-sword-slash-demo" target="_blank" rel="noopener noreferrer">
                            <img src="/images/sa.png" alt="itch.io tutorial cover" width="2486" height="1352" loading="lazy" />
                        </a>
                        <p class="kd-side-caption">Sword slash tutorial on itch.io.</p>
                    </div>
                </aside>
            </div>
        </section>

        @* ── Red Dead Redemption 2 ───────────────────────── *@
        <section id="rdr2" class="sec-block sec-mod" aria-labelledby="rdr2-title">
            <header class="sec-head" data-reveal>
                <p class="kd-eyebrow">Red Dead Redemption 2 mod</p>
                <h2 id="rdr2-title" class="sec-title">Red Dead Redemption 2 — Sarah Miller (The Last of Us)</h2>
                <p class="sec-lede">A player mod that brings Sarah from <em>The Last of Us</em> into Red Dead Redemption 2, with her own combat skills and voice.</p>
            </header>

            <div class="kd-feature-grid">
                <div class="kd-feature-main" data-reveal>
                    <div class="kd-media-frame kd-video-frame">
                        <iframe
                            src="https://www.youtube.com/embed/PQ89mPFeUOw?start=207&rel=0"
                            title="Sarah Miller RDR2 mod showcase"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen
                            referrerpolicy="strict-origin-when-cross-origin"></iframe>
                    </div>
                    <p class="kd-caption">Gameplay video — starts at the skills segment.</p>
                </div>
                <aside class="kd-feature-side">
                    <div class="kd-side-card kd-side-card-text" data-reveal data-reveal-delay="1">
                        <p class="kd-eyebrow">Player mod · RDR2</p>
                        <h3>Playable Sarah Miller</h3>
                        <ul class="kd-list">
                            <li>Custom combat skills: laser beam, sword slash and energy shield.</li>
                            <li>Skill controls also work on horseback and on wagons.</li>
                            <li>A custom-trained voice for the character.</li>
                            <li>Shipped as a drag-and-drop package — copy the files into the game folder.</li>
                        </ul>
                        <div class="kd-link-row">
                            <a class="kd-pill" href="https://www.rdr2mods.com/downloads/rdr2/player/593-sarah-miler-the-last-of-us/" target="_blank" rel="noopener noreferrer">rdr2mods.com</a>
                            <a class="kd-pill" href="/VFX#skill-vfx-chain">Skill VFX breakdown</a>
                        </div>
                        <p class="sec-note">The skill effects overlap with my <a href="/VFX">VFX work</a>.</p>
                    </div>
                </aside>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
