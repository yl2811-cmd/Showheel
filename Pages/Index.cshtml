@page
@model Showheel.Pages.IndexModel
@{
    ViewData["Title"] = "Yingrong Lin — Worldbuilder";
}

<section id="hero" class="kd-hero">
    <div
        class="kd-hero-bg background-image"
        data-motion-depth="1.1"
        data-motion-scale="1.12"
        style="background-image: url('/images/hero-city.png');"
        aria-hidden="true"
    ></div>
    <div class="kd-hero-vignette" aria-hidden="true"></div>

    <div class="kd-hero-inner">
        <h1 class="kd-hero-title">YINGRONG&nbsp;LIN</h1>
        <p class="kd-hero-tagline">SCI-FI WORLDBUILDING &nbsp;·&nbsp; 3D ENVIRONMENTS &nbsp;·&nbsp; GAME DESIGN</p>
    </div>

    <a class="kd-scroll-cue" href="#work" aria-label="Scroll to work">
        <span class="kd-scroll-arrow"></span>
    </a>
</section>

<section id="work" class="kd-work">
    <div class="kd-work-inner">
        <div class="kd-work-header">
            <p class="kd-eyebrow">Selected Work</p>
            <h2 class="kd-work-title">Four Worlds</h2>
            <p class="kd-work-lede">A flagship sci-fi universe, a portfolio of hard-surface design, environment renders, and a hand-built Minecraft mod.</p>
        </div>

        <div class="kd-grid">
            <a class="kd-card" href="/Archeon" data-card="archeon">
                <div class="kd-card-media">
                    <iframe
                        class="kd-card-video"
                        src="https://www.youtube.com/embed/7CK7ndPUiDQ?autoplay=1&mute=1&loop=1&controls=0&rel=0&showinfo=0&modestbranding=1&playsinline=1&playlist=7CK7ndPUiDQ"
                        title="Archeon reel"
                        loading="lazy"
                        allow="autoplay; encrypted-media; picture-in-picture"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"
                        tabindex="-1"
                    ></iframe>
                    <div class="kd-card-shade" aria-hidden="true"></div>
                </div>
                <div class="kd-card-meta">
                    <span class="kd-card-no">01</span>
                    <span class="kd-card-name">Archeon — Skies Beyond the Star</span>
                    <span class="kd-card-tag">Cinematic · Story · World Atlas</span>
                </div>
            </a>

            <a class="kd-card" href="/Projects" data-card="projects">
                <div class="kd-card-media">
                    <img class="kd-card-image" src="/images/hardsurface1.png" alt="Hard-surface concept render" loading="lazy" />
                    <div class="kd-card-shade" aria-hidden="true"></div>
                </div>
                <div class="kd-card-meta">
                    <span class="kd-card-no">02</span>
                    <span class="kd-card-name">Projects — Hard Surface</span>
                    <span class="kd-card-tag">Mech · Vehicles · Props</span>
                </div>
            </a>

            <a class="kd-card" href="/Environment" data-card="environment">
                <div class="kd-card-media">
                    <img class="kd-card-image" src="/images/Garden_in_the_wild1-revised.jpg" alt="Environment render preview" loading="lazy" />
                    <div class="kd-card-shade" aria-hidden="true"></div>
                </div>
                <div class="kd-card-meta">
                    <span class="kd-card-no">03</span>
                    <span class="kd-card-name">Environmental Renders</span>
                    <span class="kd-card-tag">Landscape · Lighting · Atmosphere</span>
                </div>
            </a>

            <a class="kd-card" href="/Minecraft" data-card="minecraft">
                <div class="kd-card-media">
                    <img class="kd-card-image" src="/images/mc.png" alt="Minecraft mod preview" loading="lazy" />
                    <div class="kd-card-shade" aria-hidden="true"></div>
                </div>
                <div class="kd-card-meta">
                    <span class="kd-card-no">04</span>
                    <span class="kd-card-name">Minecraft — Frieren Mod</span>
                    <span class="kd-card-tag">Independent · Combat · Quests</span>
                </div>
            </a>
        </div>
    </div>
</section>

<footer id="contact" class="kd-footer">
    <div class="kd-footer-inner">
        <p class="kd-footer-mail">Email · <a href="mailto:yl2811.rit.edu@gmail.com">yl2811.rit.edu@gmail.com</a></p>
        <div class="kd-footer-links">
            <a href="https://github.com/yl2811-cmd" target="_blank" rel="noopener noreferrer">GitHub</a>
            <span aria-hidden="true">·</span>
            <a href="https://linkedin.com/in/yingrong-lin-74524539b" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <span aria-hidden="true">·</span>
            <a href="https://space.bilibili.com/3546770577558337" target="_blank" rel="noopener noreferrer">Bilibili</a>
        </div>
    </div>
</footer>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
