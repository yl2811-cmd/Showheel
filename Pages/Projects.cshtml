@page
@model Showheel.Pages.ProjectsModel
@{
    ViewData["Title"] = "3D Art — Hard Surface — Yingrong Lin";
}

<section class="kd-detail-hero">
    <div class="kd-detail-hero-bg background-image"
         data-motion-depth="1.05"
         data-motion-scale="1.1"
         style="background-image: url('/images/hard-surface/rifle-wall-render.webp');"
         aria-hidden="true"></div>
    <div class="kd-detail-hero-shade" aria-hidden="true"></div>
    <div class="kd-detail-hero-inner">
        <p class="kd-eyebrow">01 · 3D Art</p>
        <h1 class="kd-detail-title">Hard Surface</h1>
        <p class="kd-detail-sub">Weapons, vehicles, props and characters — from line-art concept and clay pass to final render.</p>
    </div>
    <a class="kd-scroll-cue" href="#projects-body" aria-label="Scroll to content"><span class="kd-scroll-arrow"></span></a>
</section>

<section id="projects-body" class="kd-detail-body">
    <div class="kd-detail-inner">
        <header class="sec-head" data-reveal>
            <p class="kd-eyebrow">Gallery</p>
            <h2 class="sec-title">Hard surface work</h2>
            <p class="sec-lede">Finished renders lead; behind them sit the clay passes, viewport captures and line-art concept drawings. Filter by category, or open any image full screen.</p>
        </header>

        <div class="sec-toolbar" data-reveal data-reveal-delay="1">
            <div class="kd-filter" role="toolbar" aria-label="Filter" data-filter-for="hs-gallery">
                <button type="button" class="kd-chip is-active" data-filter="all" aria-pressed="true">All</button>
                <button type="button" class="kd-chip" data-filter="weapons" aria-pressed="false">Weapons</button>
                <button type="button" class="kd-chip" data-filter="vehicles" aria-pressed="false">Vehicles &amp; Mech</button>
                <button type="button" class="kd-chip" data-filter="props" aria-pressed="false">Props</button>
                <button type="button" class="kd-chip" data-filter="characters" aria-pressed="false">Characters &amp; Creatures</button>
                <button type="button" class="kd-chip" data-filter="lineart" aria-pressed="false">Concept Line Art</button>
            </div>
        </div>

        <div id="hs-gallery" class="sec-jg" data-lightbox>
            @* ── Finished renders ── *@
            <figure class="sec-tile sec-tile--feature" data-tags="weapons" style="--ar:1.778" data-reveal>
                <img src="/images/3b01db58f5af0b5693d4f661a40328033546770577558337.jpg" alt="Black sci-fi compact SMG with a mounted optic, rendered against a dark curtain" width="2486" height="1398" loading="lazy" decoding="async" />
                <figcaption><b>Compact SMG</b> — studio render with mounted optic.</figcaption>
            </figure>
            <figure class="sec-tile sec-tile--feature" data-tags="weapons" style="--ar:1.778" data-reveal>
                <img src="/images/0242e596527d8b4d7b30d33266194e933546770577558337.jpg" alt="White long rifle with a folding bipod on a black background" width="1920" height="1080" loading="lazy" decoding="async" />
                <figcaption><b>Long rifle</b> — white finish, bipod deployed.</figcaption>
            </figure>
            <figure class="sec-tile" data-tags="weapons" style="--ar:1.778" data-reveal>
                <img src="/images/hard-surface/rifle-wall-render.webp" alt="Compact rifle with optic hanging on a wall mount in a grey room" width="2560" height="1440" loading="lazy" decoding="async" />
                <figcaption><b>Compact rifle</b> — wall-mount scene render.</figcaption>
            </figure>
            <figure class="sec-tile" data-tags="weapons" style="--ar:1.778" data-reveal>
                <img src="/images/hard-surface/rifle-render.webp" alt="Silver sci-fi rifle with a skeletal stock in a dark studio" width="1920" height="1080" loading="lazy" decoding="async" />
                <figcaption><b>Rifle</b> — dark studio render.</figcaption>
            </figure>
            <figure class="sec-tile" data-tags="vehicles" style="--ar:1.409" data-reveal>
                <img src="/images/hard-surface/crawler-weathered.webp" alt="Weathered tracked vehicle with a robotic arm and a hexagonal panel" width="1123" height="797" loading="lazy" decoding="async" />
                <figcaption><b>Tracked crawler</b> — robotic arm, weathered render.</figcaption>
            </figure>
            <figure class="sec-tile" data-tags="vehicles" style="--ar:1.778" data-reveal>
                <img src="/images/hard-surface/gunship.webp" alt="Black and yellow spaceship with side engine pods" width="1600" height="900" loading="lazy" decoding="async" />
                <figcaption><b>Gunship</b> — black and yellow hull, engine pods.</figcaption>
            </figure>
            <figure class="sec-tile" data-tags="characters" style="--ar:0.563" data-reveal>
