@page
@model Showheel.Pages.UnrealModel
@{
    ViewData["Title"] = "Unreal Work — Yingrong Lin";
}

<section class="kd-detail-hero">
    <div class="kd-detail-hero-bg background-image"
         data-motion-depth="1.05"
         data-motion-scale="1.1"
         style="background-image: url('/images/hero-city.png');"
         aria-hidden="true"></div>
    <div class="kd-detail-hero-shade" aria-hidden="true"></div>
    <div class="kd-detail-hero-inner">
        <p class="kd-eyebrow">05 · Real-time</p>
        <h1 class="kd-detail-title">Unreal Work</h1>
        <p class="kd-detail-sub">Real-time environments, cinematics, and interactive experiences built in Unreal Engine.</p>
    </div>
    <a class="kd-scroll-cue" href="#unreal-body" aria-label="Scroll to content"><span class="kd-scroll-arrow"></span></a>
</section>

<section id="unreal-body" class="kd-detail-body">
    <div class="kd-detail-inner">
        <div class="kd-video-grid">
            <div class="kd-video-cell">
                <div class="kd-media-frame kd-video-frame">
                    <iframe
                        src="https://www.youtube.com/embed/3IfyIys1pp4?rel=0&controls=1"
                        title="Unreal reel 1"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            </div>
            <div class="kd-video-cell">
                <div class="kd-media-frame kd-video-frame">
                    <iframe
                        src="https://www.youtube.com/embed/AwpYBEN5Y8k?rel=0&controls=1"
                        title="Unreal reel 2"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            </div>
            <div class="kd-video-cell">
                <div class="kd-media-frame kd-video-frame">
                    <iframe
                        src="https://www.youtube.com/embed/CcIrP0J83s0?rel=0&controls=1"
                        title="Unreal reel 3"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            </div>
            <div class="kd-video-cell">
                <div class="kd-media-frame kd-video-frame">
                    <iframe
                        src="https://www.youtube.com/embed/mlaQNKSlszA?rel=0&controls=1"
                        title="Unreal reel 4"
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
