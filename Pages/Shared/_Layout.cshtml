@{
    var pageTitle = ViewData["Title"] as string ?? "Yingrong Lin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Manrope:wght@400;600&family=Archivo+Black&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="kd-topbar">
        <a class="kd-brand" href="/" aria-label="Home">
            <span class="kd-brand-mark">YL</span>
        </a>
        <nav class="kd-nav" aria-label="Primary">
            <a href="/#work">WORK</a>
            <a href="/Gallery">GALLERY</a>
            <a href="/About">ABOUT</a>
        </nav>
    </header>

    <main id="main" role="main" tabindex="-1">
        @RenderBody()
    </main>

    @RenderSection("Scripts", required: false)
</body>
</html>
